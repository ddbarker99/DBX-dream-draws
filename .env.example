# Copy to .env and fill in:  cp .env.example .env
SITE_URL=https://dbxdreamdraws.co.uk
SITE_NAME=DBX Dream Draws
SITE_TAGLINE=Win something brilliant.
# Where contact-form messages go (defaults to MAIL_FROM)
SUPPORT_EMAIL=
# Free postal entry address — legally required, shown on /free-entry. e.g. "DBX Dream Draws Free Entry, 10 High Street, Town, AB1 2CD"
POSTAL_ADDRESS=
# Competitions can't go live without POSTAL_ADDRESS (free entry route). Draws also need a prize photo unless:
# REQUIRE_COMP_IMAGE=0
# Cookies are HTTPS-only automatically when SITE_URL starts with https:// (override with SECURE_COOKIES=0/1)
# Shown in the footer and terms, e.g. "PrizeHub Ltd, company no. 12345678, registered in England"
COMPANY_DETAILS=

# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Stripe (Dashboard → Developers). Use sk_test_... first, then sk_live_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 1 = fake checkout for testing when Stripe keys are empty. Set to 0 before going live!
DEMO_PAYMENTS=1

# Wallet credit a member gets when a friend they referred makes a first purchase (£)
REFERRAL_BONUS=1
# Highest monthly spend limit anyone can set (£)
MAX_MONTHLY_LIMIT=250

# Email (optional but recommended — password resets, ticket confirmations, winner emails).
# Hostinger email: SMTP_HOST=smtp.hostinger.com SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Post new competitions, winners and "we're live" to a Discord channel
DISCORD_WEBHOOK_URL=

# Social links shown in the footer (leave blank to hide)
FACEBOOK_URL=
INSTAGRAM_URL=
TIKTOK_URL=
YOUTUBE_URL=
DISCORD_URL=
TWITCH_URL=

# Your Trustpilot page (shown in the footer)
TRUSTPILOT_URL=

# UK prize-draw code: refuse credit cards (payment auto-refunded). 0 to allow.
BLOCK_CREDIT_CARDS=1
